# Wisp is discovered by the browser. Do not put secrets in NEXT_PUBLIC_* values.
# Wisp runtimes the browser looks for, comma separated. Each entry is a URL, or "name=URL". The grey text
# next to the model is "local" for this machine, the address for another one, or the name you give.
# Default: ports 8781 to 8785 on this machine (Python defaults to 8781, Candle to 8782).
# NEXT_PUBLIC_WISP_LOCAL_URLS=http://127.0.0.1:8781,gpu-box=http://192.168.1.20:8782

# Optional server-side override: local disables simulations; hosted enables the
# clearly labelled fallback for routes that are not configured.
WISP_BENCH_MODE=local

# Optional local Ollama comparison.
OLLAMA_URL=http://127.0.0.1:11434
# One or several models installed in Ollama, comma separated (shown by name in the list).
OLLAMA_MODELS=

# Optional OpenAI-compatible endpoint: LM Studio, llama.cpp, vLLM, LiteLLM, OpenAI, etc.
# Examples: http://127.0.0.1:1234/v1 (LM Studio) or https://api.openai.com/v1 (with a key).
# Anthropic's own endpoint is not usable yet (it rejects json_object): reach Claude through OpenRouter.
OPENAI_COMPATIBLE_URL=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_API_KEY=

# Optional user-owned OpenRouter access. Never commit a real key.
# One key reaches many providers, including Claude. Copy the model id from openrouter.ai/models.
# Example: OPENROUTER_MODEL=typesafe/jev-1.13   (Jev; or anthropic/<model-name> for a Claude model)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
